# ── Required for a production build (the build stops if any is missing) ─────────────────────────────
# Backend API (your Railway URL, https, no trailing slash)
VITE_API_URL=https://stablebackend-production.up.railway.app
# Security pins: the ONLY contracts, chain and RPC this website will ever ask a wallet to use.
# Even if the API or database were hacked and served other addresses, the site refuses to trade.
VITE_MARKET_ADDRESS=0x...
VITE_FACTORY_ADDRESSES=0x...
VITE_CHAIN_ID=91342
VITE_RPC_URL=https://sepolia-rpc.giwa.io

# ── Optional ─────────────────────────────────────────────────────────────────────────────────────────
# Block explorer used for links (defaults to the one the API reports)
VITE_EXPLORER_URL=https://sepolia-explorer.giwa.io
# Ethereum mainnet RPC for the live gas reading in the status bar
VITE_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
# GIWA COWS X link shown on the GIWA COWS page
VITE_GIWA_COWS_X=

# Backend API (your Railway URL in production, https, no trailing slash)
VITE_API_URL=http://localhost:8080
# Optional: Ethereum mainnet RPC for the live gas reading in the status bar
VITE_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
# Optional: GIWA COWS X link shown on the GIWA COWS page
VITE_GIWA_COWS_X=
# The GIWA network (chain, RPC, explorer) comes from the backend (/api/config). Set VITE_RPC_URL only to override it locally.
# VITE_RPC_URL=
